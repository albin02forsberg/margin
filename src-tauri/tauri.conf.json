{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin",
  "version": "0.2.0",
  "identifier": "dev.albin.margin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Margin",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": { "depends": ["libxss1"] },
      "rpm": { "depends": ["libXScrnSaver"] }
    },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "10.15" }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0QjE3QTVERUYxQjhERkQKUldUOWpSdnZYWHF4eEdFMnRwTEk5Z1haaGsyRFg3WnZ6WDdUeXg0ZDNBU2dxRS9uVXhra05uZUMK",
      "endpoints": [
        "https://github.com/albin02forsberg/margin/releases/latest/download/latest.json"
      ]
    }
  }
}
